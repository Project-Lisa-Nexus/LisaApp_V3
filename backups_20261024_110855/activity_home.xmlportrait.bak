<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Guideline 45% verticale tra pannello Avatar/Mic e Griglia in portrait -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.60" />

    <!-- Avatar + Microfono + Vignetta Diagnostica Container (Sezione Superiore) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/avatar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline_top_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <!-- Avatar Lisa racchiuso in una CardView circolare per il ritaglio -->
        <ImageView
    android:id="@+id/avatar_image"
    android:layout_width="180dp"
    android:layout_height="180dp"
    android:src="@drawable/lisa_avatar"
    android:scaleType="centerCrop"
    android:contentDescription="Avatar Lisa"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toTopOf="@id/mic_button"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp" />

        <!-- Microfono 64dp x 64dp con mic_onde -->
        <FrameLayout
            android:id="@+id/mic_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/avatar_image"
            app:layout_constraintBottom_toTopOf="@id/vignetta_diagnostica"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/mic_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/mic_onde"
                android:scaleType="centerInside"
                android:contentDescription="Microfono Lisa" />
        </FrameLayout>

        <!-- Vignetta Diagnostica (riservata 60dp) -->
        <View
            android:id="@+id/vignetta_diagnostica"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toBottomOf="@id/mic_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NestedScrollView solo per la griglia di card -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/grid_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/guideline_top_section"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Griglia 2x2: Card AI, Card Pad, Card Voice, Card Eye -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/grid_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <!-- Card 1: Lisa AI (Alto Sinistra) -->
            <FrameLayout
                android:id="@+id/card_ai"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/card_pad"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/icon_ai"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_ai"
                    android:scaleType="centerInside"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Lisa AI" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/title_ai"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lisa AI"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="18sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Card 2: Lisa Pad (Alto Destra) -->
            <FrameLayout
                android:id="@+id/card_pad"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_ai"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/icon_pad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_pad"
                    android:scaleType="centerInside"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Lisa Pad" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/title_pad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lisa Pad"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="18sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Card 3: Lisa Voice (Basso Sinistra) -->
            <FrameLayout
                android:id="@+id/card_voice"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintTop_toBottomOf="@id/card_ai"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/card_eye"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/icon_voice"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_voice"
                    android:scaleType="centerInside"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Lisa Voice" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/title_voice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lisa Voice"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="18sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Card 4: Lisa Eye (Basso Destra) -->
            <FrameLayout
                android:id="@+id/card_eye"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintTop_toBottomOf="@id/card_pad"
                app:layout_constraintStart_toEndOf="@id/card_voice"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/icon_eye"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_eye"
                    android:scaleType="centerInside"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Lisa Eye" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/title_eye"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lisa Eye"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="18sp" />
                </LinearLayout>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Barra Inferiore 60dp ancorata al fondo -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#000000"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/bottom_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:src="@drawable/ic_home_home"
            android:contentDescription="Home" />

        <ImageView
            android:id="@+id/bottom_star"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:src="@drawable/ic_home_star"
            android:contentDescription="Preferiti" />

        <ImageView
            android:id="@+id/bottom_profile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:src="@drawable/ic_home_profile"
            android:contentDescription="Profilo" />

        <ImageView
            android:id="@+id/bottom_menu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:src="@drawable/ic_home_menu"
            android:contentDescription="Menu" />

        <ImageView
            android:id="@+id/arrow_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_home_arrow"
            android:contentDescription="Freccia impostazioni" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
